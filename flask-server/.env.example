# Copy this file to `.env` and adjust as needed. All values are optional:
# the server falls back to sensible defaults relative to the project root.

# App data CSVs (tracks.csv, features.csv).
# Default: <project_root>/data
# WHYPOP_DATA_DIR=../data

# React public directory (contains the concept image folders).
# Default: <project_root>/public
# WHYPOP_PUBLIC_DIR=../public

# Which concept-discovery run to serve. Must match a folder name under PUBLIC_DIR,
# e.g. public/seventh_concepts/ -> "seventh_concepts".
# Default: seventh_concepts
# WHYPOP_CONCEPTS_SET=seventh_concepts

# Directory holding the fma_small MP3s, laid out as <dir>/000/000123.mp3.
# Point this at wherever you extracted the FMA audio.
# Default: <PUBLIC_DIR>/fma_small
# WHYPOP_FMA_SMALL_DIR=/path/to/fma_small/fma_small

# Fallback image returned when no concept patch is found for a track.
# Default: <PUBLIC_DIR>/error_image.png
# WHYPOP_ERROR_IMAGE=../public/error_image.png
